  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Fleet overview",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Read with evidence first: **health** comes from the independently cached health scan, **work** from the ledger. A component reporting its own failure is a single alert; dependent alerts are suppressed while its snapshot is stale. Statistics are logical metadata-sample sums, not physical storage; unassessed tables contribute nothing. A table named by two connections counts in each, so connection totals are not additive."
      },
      "targets": [],
      "datasource": {
        "type": "prometheus",
        "uid": "bergsmith-prometheus"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ledger refresh",
      "description": "1 when the last ledger read succeeded",
      "datasource": {
        "type": "prometheus",
        "uid": "bergsmith-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bergsmith_ledger_up",
          "datasource": {
            "type": "prometheus",
            "uid": "bergsmith-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
