{
  "realm": "bergsmith",
  "enabled": true,
  "displayName": "Bergsmith development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "clients": [
    {
      "clientId": "bergsmith",
      "name": "Bergsmith coordinator (development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "development-only-not-a-real-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://127.0.0.1:8080",
      "redirectUris": [
        "http://127.0.0.1:8080/auth/callback",
        "http://localhost:8080/auth/callback",
        "http://127.0.0.1:5173/auth/callback",
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8080",
        "http://localhost:8080",
        "http://127.0.0.1:5173",
        "http://localhost:5173"
      ],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "id": "01900000-0000-7000-8000-000000000005",
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Operator",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "development-only-not-a-real-password",
          "temporary": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "bergsmith-admin" },
      { "name": "bergsmith-operator" }
    ]
  },
  "defaultRoles": ["bergsmith-operator"]
}
