    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "disposition",
          "operator_action"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "authentication_required",
              "csrf_rejected",
              "invalid_request",
              "resource_not_found",
              "permission_denied",
              "idempotency_key_reused",
              "ledger_unavailable",
              "previews_unavailable",
              "scheduling_unavailable",
              "method_not_allowed",
              "request_too_large",
              "internal_error"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "RetrySameRequest",
              "RetryTask",
              "ReplanRequired",
              "PermanentFailure",
              "ResolvePublication"
            ]
          },
          "operator_action": {
            "type": "string"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
