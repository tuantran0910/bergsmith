            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TableAlias": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog_id",
          "namespace",
          "name"
        ],
        "properties": {
          "catalog_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          }
        }
