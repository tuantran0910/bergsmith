        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "resource_url": {
            "type": "string"
          }
        }
      },
      "CatalogPage": {
