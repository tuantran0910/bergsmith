            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Table": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "table_uuid",
          "created_at",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "table_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "aliases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TableAlias"
            }
          }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "table_id",
          "state",
          "revision",
          "state_reason",
          "retry_of_job_id",
          "created_by",
          "created_at",
          "updated_at",
          "cancellation_requested",
          "publication_started"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "table_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "Planning",
              "Queued",
              "Running",
              "ReadyToCommit",
              "Committing",
              "CommitOutcomeUnknown",
              "Cancelling",
              "Succeeded",
              "NoOp",
              "Cancelled",
              "ReplanRequired",
              "Failed"
            ]
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "state_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_of_job_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_by": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "cancellation_requested": {
            "type": "boolean"
          },
          "publication_started": {
            "type": "boolean"
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actor_principal_id",
          "actor_kind",
          "action",
          "resource_type",
          "resource_id",
          "outcome",
          "detail",
          "occurred_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "actor_principal_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "actor_kind": {
            "type": "string",
            "enum": [
              "User",
              "Service",
              "Anonymous",
              "System"
            ]
          },
          "action": {
            "type": "string"
          },
          "resource_type": {
            "type": "string"
          },
          "resource_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "Allowed",
              "Denied",
              "Failed"
            ]
          },
          "detail": {
            "type": "object",
            "additionalProperties": true
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
